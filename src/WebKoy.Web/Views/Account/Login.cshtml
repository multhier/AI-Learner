@model LoginViewModel
@{ ViewData["Title"] = "Giriş"; }
<div class="row justify-content-center">
    <div class="col-md-6 col-lg-4">
        <h2 class="mb-3">Giriş yap</h2>
        <form method="post">
            <input type="hidden" asp-for="ReturnUrl" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
            <div class="mb-3">
                <label asp-for="Login" class="form-label"></label>
                <input asp-for="Login" class="form-control" autocomplete="username" autofocus />
                <span asp-validation-for="Login" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-control" autocomplete="current-password" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>
            <div class="form-check mb-3">
                <input asp-for="RememberMe" class="form-check-input" />
                <label asp-for="RememberMe" class="form-check-label"></label>
            </div>
            <button type="submit" class="btn btn-wk w-100">Giriş</button>
        </form>
        <p class="mt-3 mb-1"><a asp-action="ForgotPassword">Şifremi unuttum</a></p>
        <p>Hesabın yok mu? <a asp-action="Register">Ücretsiz site aç</a></p>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
