@model ResetPasswordViewModel
@{ ViewData["Title"] = "Yeni şifre"; }
<div class="row justify-content-center">
    <div class="col-md-6 col-lg-4">
        <h2 class="mb-3">Yeni şifre belirle</h2>
        <form method="post">
            <input type="hidden" asp-for="UserId" />
            <input type="hidden" asp-for="Code" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-control" autocomplete="new-password" autofocus />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="ConfirmPassword" class="form-label"></label>
                <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>
            <button class="btn btn-wk w-100">Şifreyi değiştir</button>
        </form>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
