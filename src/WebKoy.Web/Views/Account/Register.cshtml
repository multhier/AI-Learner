@model RegisterViewModel
@inject Microsoft.Extensions.Options.IOptions<PlatformOptions> Opt
@inject CaptchaVerifier Captcha
@{ ViewData["Title"] = "Site aç"; }
<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <h2 class="mb-3">Ücretsiz siteni aç</h2>
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
            <div class="mb-3">
                <label asp-for="SiteName" class="form-label"></label>
                <div class="input-group">
                    <input asp-for="SiteName" class="form-control" autocomplete="off" autofocus />
                    <span class="input-group-text">.@Opt.Value.SitesDomain</span>
                </div>
                <div class="form-text">Küçük harf, rakam ve tire. Bu aynı zamanda kullanıcı adınız olacak.</div>
                <span asp-validation-for="SiteName" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Tags" class="form-label"></label>
                <input asp-for="Tags" class="form-control" placeholder="sanat, oyun, müzik, programlama, kediler" />
                <div class="form-text">Virgülle ayırın, en fazla 5. Keşfet sayfasında bulunmanı sağlar.</div>
            </div>
            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" autocomplete="email" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="ConfirmPassword" class="form-label"></label>
                <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>
            <div class="form-check mb-3">
                <input asp-for="AcceptTerms" class="form-check-input" />
                <label asp-for="AcceptTerms" class="form-check-label"><a asp-controller="Home" asp-action="Terms" target="_blank">Kullanım koşullarını</a> okudum, kabul ediyorum.</label>
                <div><span asp-validation-for="AcceptTerms" class="text-danger"></span></div>
            </div>
            @if (Captcha.Enabled)
            {
                <div class="h-captcha mb-3" data-sitekey="@Captcha.SiteKey"></div>
            }
            <button type="submit" class="btn btn-wk w-100">Sitemi oluştur</button>
        </form>
        <p class="mt-3">Zaten hesabın var mı? <a asp-action="Login">Giriş yap</a></p>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    @if (Captcha.Enabled)
    {
        <script src="https://js.hcaptcha.com/1/api.js" async defer></script>
    }
}
