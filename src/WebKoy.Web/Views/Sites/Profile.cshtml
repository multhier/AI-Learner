@model SiteProfileViewModel
@{
    ViewData["Title"] = Model.Site.Title ?? Model.Site.Name;
    var signedIn = User.Identity?.IsAuthenticated == true;
    var isAdmin = User.IsInRole(DbInitializer.AdminRole);
}
<div class="row g-4">
    <div class="col-lg-8">
        <h2 class="mb-1">@(Model.Site.Title ?? Model.Site.Name)</h2>
        <a href="@Model.Url" target="_blank" rel="noopener">@Model.Url ↗</a>
        @if (Model.Site.IsBanned)
        {
            <div class="alert alert-danger mt-2">Bu site askıya alındı. @Model.Site.BanReason</div>
        }
        @if (!string.IsNullOrEmpty(Model.Site.Description))
        {
            <p class="mt-3">@Model.Site.Description</p>
        }
        <div class="mb-3">
            @foreach (var t in Model.Tags) { <a class="badge wk-tag" href="/browse?tag=@t">#@t</a> }
        </div>

        <div class="ratio ratio-16x9 wk-preview mb-4">
            <iframe src="@Model.Url" title="Site önizlemesi" sandbox="allow-scripts" loading="lazy" referrerpolicy="no-referrer"></iframe>
        </div>

        <h4>Yorumlar (@Model.Comments.Count)</h4>
        @if (signedIn)
        {
            <form asp-action="Comment" asp-route-name="@Model.Site.Name" method="post" class="mb-3">
                <textarea name="body" class="form-control mb-2" rows="2" maxlength="1000" placeholder="Bir şeyler yaz..." required></textarea>
                <button class="btn btn-wk btn-sm">Yorum yap</button>
            </form>
        }
        else
        {
            <p><a asp-controller="Account" asp-action="Login" asp-route-returnUrl="/site/@Model.Site.Name">Giriş yapın</a>, yorum bırakın.</p>
        }
        @foreach (var c in Model.Comments)
        {
            <div class="border-bottom py-2">
                <div class="small text-muted d-flex justify-content-between">
                    <span><a href="/site/@c.AuthorSite">@c.AuthorSite</a> · @c.CreatedAt.ToLocalTime().ToString("g")</span>
                    @if (c.CanDelete)
                    {
                        <form asp-action="DeleteComment" asp-route-name="@Model.Site.Name" method="post">
                            <input type="hidden" name="id" value="@c.Id" />
                            <button class="btn btn-link btn-sm p-0 text-danger">sil</button>
                        </form>
                    }
                </div>
                <div style="white-space: pre-wrap">@c.Body</div>
            </div>
        }
    </div>

    <aside class="col-lg-4">
        <div class="card wk-card mb-3">
            <div class="card-body">
                <ul class="list-unstyled mb-3">
                    <li>👁 <strong>@Model.Site.Views.ToString("N0")</strong> görüntülenme <span class="small text-muted">(@Model.Site.Hits.ToString("N0") istek)</span></li>
                    <li>♥ <strong>@Model.Likes</strong> beğeni</li>
                    <li>👥 <strong>@Model.Followers</strong> takipçi</li>
                    <li class="small text-muted mt-2">Açılış: @Model.Site.CreatedAt.ToLocalTime().ToString("d")</li>
                    <li class="small text-muted">Son güncelleme: @Model.Site.UpdatedAt.ToLocalTime().ToString("g")</li>
                </ul>
                @if (signedIn && !Model.IsOwner)
                {
                    <div class="d-flex gap-2">
                        <form asp-action="Follow" asp-route-name="@Model.Site.Name" method="post">
                            <button class="btn btn-sm @(Model.IsFollowing ? "btn-secondary" : "btn-wk")">@(Model.IsFollowing ? "Takibi bırak" : "Takip et")</button>
                        </form>
                        <form asp-action="Like" asp-route-name="@Model.Site.Name" method="post">
                            <button class="btn btn-sm btn-outline-danger">@(Model.IsLiked ? "♥ Beğendin" : "♡ Beğen")</button>
                        </form>
                    </div>
                }
                @if (Model.IsOwner)
                {
                    <a class="btn btn-sm btn-wk" asp-controller="Dashboard" asp-action="Index">Siteni düzenle</a>
                }
            </div>
        </div>

        @if (isAdmin)
        {
            <div class="card border-warning mb-3"><div class="card-body">
                <h6>Yönetici</h6>
                @if (Model.Site.IsBanned)
                {
                    <form asp-controller="Admin" asp-action="Unban" method="post"><input type="hidden" name="name" value="@Model.Site.Name" /><button class="btn btn-sm btn-success">Askıyı kaldır</button></form>
                }
                else
                {
                    <form asp-controller="Admin" asp-action="Ban" method="post" class="d-flex gap-1">
                        <input type="hidden" name="name" value="@Model.Site.Name" />
                        <input class="form-control form-control-sm" name="reason" placeholder="Sebep" />
                        <button class="btn btn-sm btn-danger">Askıya al</button>
                    </form>
                }
            </div></div>
        }

        @if (!Model.IsOwner)
        {
            <details class="small">
                <summary>Bu siteyi şikayet et</summary>
                <form asp-action="Report" asp-route-name="@Model.Site.Name" method="post" class="mt-2">
                    <select name="Reason" class="form-select form-select-sm mb-2" asp-items="Html.GetEnumSelectList<ReportReason>()"></select>
                    <textarea name="Details" class="form-control form-control-sm mb-2" rows="2" maxlength="2000" placeholder="Ayrıntılar (isteğe bağlı)"></textarea>
                    <button class="btn btn-sm btn-outline-danger">Gönder</button>
                </form>
            </details>
        }
    </aside>
</div>
