@model SiteSettingsViewModel
@{ ViewData["Title"] = "Site ayarları"; }
<div class="row justify-content-center">
    <div class="col-lg-7">
        <h2>Site ayarları</h2>
        <form method="post" class="mb-5">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <div class="mb-3">
                <label asp-for="Title" class="form-label"></label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Tags" class="form-label"></label>
                <input asp-for="Tags" class="form-control" placeholder="sanat, oyun, blog" />
            </div>
            <button class="btn btn-wk">Kaydet</button>
        </form>

        <div class="card wk-card mb-4">
            <div class="card-body">
                <h5>API anahtarı</h5>
                <p class="small">Sitenizi kendi betiklerinizden veya dağıtım araçlarınızdan yönetmek için. Anahtarı gizli tutun; sitenizin dosyalarına tam erişim verir.</p>
                @if (Model.NewApiKey is not null)
                {
                    <div class="alert alert-warning">
                        <div class="small mb-1">Bu anahtar yalnızca şimdi gösteriliyor, kopyalayın:</div>
                        <code class="user-select-all text-break">@Model.NewApiKey</code>
                    </div>
                    <pre class="small bg-light p-2 rounded text-wrap"><code>curl -H "Authorization: Bearer @Model.NewApiKey" \
  -F "index.html=@@index.html" \
  @Model.ApiBaseUrl/upload</code></pre>
                }
                else if (Model.ApiKeyCreatedAt is { } created)
                {
                    <p class="small text-muted">Etkin anahtar: @created.ToLocalTime().ToString("g") tarihinde oluşturuldu.</p>
                }
                <div class="d-flex gap-2">
                    <form asp-action="ApiKey" method="post">
                        <button class="btn btn-sm btn-wk">@(Model.ApiKeyCreatedAt is null ? "Anahtar oluştur" : "Yeni anahtar oluştur")</button>
                    </form>
                    @if (Model.ApiKeyCreatedAt is not null)
                    {
                        <form asp-action="ApiKey" method="post">
                            <input type="hidden" name="revoke" value="true" />
                            <button class="btn btn-sm btn-outline-danger">İptal et</button>
                        </form>
                    }
                    <a class="btn btn-sm btn-outline-secondary" href="/developers">API belgeleri</a>
                </div>
            </div>
        </div>

        <div class="card border-danger">
            <div class="card-body">
                <h5 class="text-danger">Hesabı sil</h5>
                <p class="small">Siteniz, tüm dosyalarınız, yorumlarınız ve takipleriniz kalıcı olarak silinir. Bu işlem geri alınamaz.</p>
                <form asp-controller="Account" asp-action="Delete" method="post" class="d-flex gap-2">
                    <input class="form-control" name="confirmName" placeholder="Onay için site adınızı yazın: @Model.Name" required />
                    <button class="btn btn-danger text-nowrap">Kalıcı olarak sil</button>
                </form>
            </div>
        </div>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
