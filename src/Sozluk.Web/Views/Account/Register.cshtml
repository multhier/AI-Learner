@model RegisterInput
@{ ViewData["Title"] = "kayıt ol"; }
<h1 class="page-title">kayıt ol</h1>
<form method="post" class="auth-form">
    <div asp-validation-summary="All" class="alert error"></div>
    <label asp-for="UserName">nick</label>
    <input asp-for="UserName" autocomplete="username" />
    <label asp-for="Email">e-posta</label>
    <input asp-for="Email" autocomplete="email" />
    <label asp-for="Password">şifre</label>
    <input asp-for="Password" autocomplete="new-password" />
    <label asp-for="ConfirmPassword">şifre (tekrar)</label>
    <input asp-for="ConfirmPassword" autocomplete="new-password" />
    <button type="submit" class="primary">kayıt ol</button>
</form>
