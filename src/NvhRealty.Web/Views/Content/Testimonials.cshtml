@model List<Testimonial>
@{ ViewData["Title"] = "Müşteri Yorumları"; var s = await SiteSettings.GetAllAsync(); }
<section class="page-header"><div class="container"><h1>Müşteri Yorumları</h1><p class="mb-0">@s["Slogan"]</p></div></section>
<div class="container py-4">
    @foreach (var t in Model) { <partial name="_Testimonial" model="t" /> }
    @if (Model.Count == 0) { <p>Henüz yorum yok.</p> }
</div>
