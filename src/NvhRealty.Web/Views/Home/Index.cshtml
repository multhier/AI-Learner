@model HomeViewModel
@{
    var s = await SiteSettings.GetAllAsync();
    ViewData["Title"] = "";
}
<section id="hero" class="carousel slide hero" data-bs-ride="carousel" aria-label="Öne çıkanlar">
    <div class="carousel-inner">
        @for (var i = 1; i <= 3; i++)
        {
            <div class="carousel-item @(i == 1 ? "active" : "")" style="background-image:url('/img/hero-@(i).svg')">
                <div class="hero-caption">
                    <h1>@s["Slogan"]</h1>
                </div>
            </div>
        }
    </div>
    <button class="carousel-control-prev" type="button" data-bs-target="#hero" data-bs-slide="prev"><span class="carousel-control-prev-icon" aria-hidden="true"></span><span class="visually-hidden">Önceki</span></button>
    <button class="carousel-control-next" type="button" data-bs-target="#hero" data-bs-slide="next"><span class="carousel-control-next-icon" aria-hidden="true"></span><span class="visually-hidden">Sonraki</span></button>
</section>

<section class="quick-search">
    <div class="container">
        <form action="/properties" method="get" class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label" for="qs-type">İlan tipi</label>
                <select id="qs-type" name="Type" class="form-select">
                    <option value="Sale">Satılık</option>
                    <option value="Rental">Kiralık</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label" for="qs-beds">Yatak odası</label>
                <select id="qs-beds" name="MinBeds" class="form-select">
                    <option value="">Tümü</option>
                    <option value="0">Stüdyo+</option>
                    @for (var b = 1; b <= 5; b++) { <option value="@b">@b+</option> }
                </select>
            </div>
            <div class="col-md-2"><label class="form-label" for="qs-min">Min. fiyat</label><input id="qs-min" name="MinPrice" type="number" min="0" class="form-control" /></div>
            <div class="col-md-2"><label class="form-label" for="qs-max">Maks. fiyat</label><input id="qs-max" name="MaxPrice" type="number" min="0" class="form-control" /></div>
            <div class="col-md-2"><button class="btn btn-primary w-100" type="submit">Ara</button></div>
        </form>
    </div>
</section>

<section class="section">
    <div class="container">
        <h2 class="section-title">Neden Bizimle Çalışmalısınız?</h2>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="why-box">
                    <h3>Danışmanlarımız</h3>
                    @if (Model.FeaturedAgent is { } a)
                    {
                        <a href="/agents/@a.Id" class="d-flex gap-3 text-reset text-decoration-none">
                            <img src="@(a.PhotoUrl ?? "/img/agent-placeholder.svg")" alt="@a.FullName" class="agent-thumb" />
                            <div>
                                <strong>@a.FullName</strong><br />
                                <span class="small text-muted">@s["CompanyName"]</span>
                            </div>
                        </a>
                        <p class="mt-3">@a.Bio.Excerpt(210)</p>
                    }
                    <a href="/agents" class="btn btn-outline-primary btn-sm">Tüm danışmanlar</a>
                </div>
            </div>
            <div class="col-md-4">
                <div class="why-box">
                    <h3>İlanlarımız</h3>
                    <img src="/img/listing-2.svg" alt="" class="why-img" />
                    <p>@s["HomeListingsText"] <a href="/properties/rentals">Kiralık</a> ve <a href="/properties/sales">satılık</a> ilanlarımıza göz atın.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="why-box">
                    <h3>Araçlarımız</h3>
                    <img src="/img/listing-5.svg" alt="" class="why-img" />
                    <p>@s["HomeToolsText"] <a href="/properties">Mülk bul</a>.</p>
                </div>
            </div>
        </div>
    </div>
</section>

@if (Model.LatestSales.Count > 0)
{
    <section class="section section-alt">
        <div class="container">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h2 class="section-title mb-0">Yeni Satılık İlanlar</h2>
                <a href="/properties/sales">Tümünü gör →</a>
            </div>
            <div class="row g-4">
                @foreach (var l in Model.LatestSales) { <div class="col-md-4"><partial name="_ListingCard" model="l" /></div> }
            </div>
        </div>
    </section>
}
@if (Model.LatestRentals.Count > 0)
{
    <section class="section">
        <div class="container">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h2 class="section-title mb-0">Yeni Kiralık İlanlar</h2>
                <a href="/properties/rentals">Tümünü gör →</a>
            </div>
            <div class="row g-4">
                @foreach (var l in Model.LatestRentals) { <div class="col-md-4"><partial name="_ListingCard" model="l" /></div> }
            </div>
        </div>
    </section>
}
