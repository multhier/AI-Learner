@model ListingDetailsViewModel
@{
    var l = Model.Listing;
    ViewData["Title"] = l.DisplayTitle;
    ViewData["Description"] = l.Description.Excerpt(160);
    var features = new (bool On, string Label)[]
    {
        (l.HasDoorman, "Kapıcı"), (l.HasElevator, "Asansör"), (l.HasLaundry, "Çamaşırhane"), (l.HasPool, "Havuz"),
        (l.HasOutdoorSpace, "Açık alan"), (l.HasParking, "Otopark"), (l.LaundryInUnit, "Dairede çamaşır makinesi"),
        (l.NoFee, "Komisyonsuz"), (l.PrivateOutdoorSpace, "Özel açık alan"), (l.IsShortTerm, "Kısa dönem"),
        (l.CentralAirConditioning, "Merkezi klima"), (l.CatsOk, "Kedi olur"), (l.DogsOk, "Köpek olur")
    }.Where(f => f.On).ToList();
}
<section class="page-header"><div class="container">
    <h1>@l.Address@(string.IsNullOrEmpty(l.Unit) ? "" : $", #{l.Unit}")</h1>
    <p class="mb-0">@l.Neighborhood?.Name, @l.Neighborhood?.Area?.Name · @l.PropertyType.DisplayName() · @l.ListingType.DisplayName()</p>
</div></section>

<div class="container py-4">
    <div class="row g-4">
        <div class="col-lg-8">
            <div id="gallery" class="carousel slide gallery" data-bs-ride="false">
                <div class="carousel-inner">
                    @{ var photos = l.Photos.Count > 0 ? l.Photos.Select(p => p.Url).ToList() : new List<string> { "/img/listing-1.svg" }; }
                    @for (var i = 0; i < photos.Count; i++)
                    {
                        <div class="carousel-item @(i == 0 ? "active" : "")"><img src="@photos[i]" class="d-block w-100" alt="@l.DisplayTitle — fotoğraf @(i + 1)" /></div>
                    }
                </div>
                @if (photos.Count > 1)
                {
                    <button class="carousel-control-prev" type="button" data-bs-target="#gallery" data-bs-slide="prev"><span class="carousel-control-prev-icon" aria-hidden="true"></span><span class="visually-hidden">Önceki</span></button>
                    <button class="carousel-control-next" type="button" data-bs-target="#gallery" data-bs-slide="next"><span class="carousel-control-next-icon" aria-hidden="true"></span><span class="visually-hidden">Sonraki</span></button>
                }
            </div>

            <div class="d-flex flex-wrap justify-content-between align-items-center my-3 gap-2">
                <div class="listing-price fs-3">@l.PriceLabel()</div>
                <div class="d-flex gap-2">
                    @if (l.Status != ListingStatus.Active) { <span class="badge text-bg-warning fs-6">@l.Status.DisplayName()</span> }
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <form method="post" action="/properties/@l.Id/favorite">
                            @Html.AntiForgeryToken()
                            <button class="btn btn-sm @(Model.IsFavorite ? "btn-primary" : "btn-outline-primary")" type="submit">@(Model.IsFavorite ? "★ Favorilerde" : "☆ Favorilere ekle")</button>
                        </form>
                    }
                    else
                    {
                        <a class="btn btn-sm btn-outline-primary" href="/account/login?returnUrl=/properties/@l.Id">☆ Favorilere ekle</a>
                    }
                </div>
            </div>

            <table class="table facts-table">
                <tbody>
                    @if (!l.IsCommercial) { <tr><th>Yatak odası</th><td>@l.BedsLabel()</td></tr> }
                    <tr><th>Banyo</th><td>@l.BathsLabel()</td></tr>
                    @if (l.Families is int fm) { <tr><th>Aile sayısı</th><td>@fm</td></tr> }
                    @if (l.SquareFeet is int sq) { <tr><th>Alan</th><td>@sq.ToString("N0") ft²</td></tr> }
                    @if (l.MonthlyExpense is decimal me) { <tr><th>Aylık gider</th><td>@me.Money()</td></tr> }
                    @if (l.AvailableOn is DateTime av) { <tr><th>Müsaitlik</th><td>@av.ToString("dd.MM.yyyy")</td></tr> }
                    @if (l.OpenHouseAt is DateTime oh) { <tr><th>Açık ev</th><td>@oh.ToString("dd.MM.yyyy HH:mm")</td></tr> }
                    <tr><th>İlan tarihi</th><td>@l.ListedOn.ToString("dd.MM.yyyy")</td></tr>
                    <tr><th>İlan no</th><td>#@l.Id</td></tr>
                </tbody>
            </table>

            @if (!string.IsNullOrEmpty(l.Description))
            {
                <h4>Açıklama</h4>
                <div class="rich-text">@Html.Raw(l.Description)</div>
            }
            @if (features.Count > 0)
            {
                <h4 class="mt-4">Özellikler</h4>
                <ul class="feature-list">@foreach (var f in features) { <li>@f.Label</li> }</ul>
            }
            @if (!string.IsNullOrEmpty(l.VirtualTourUrl))
            {
                <p class="mt-3"><a class="btn btn-outline-primary" href="@l.VirtualTourUrl" target="_blank" rel="noopener">360° Sanal Tur</a></p>
            }
            @if (!string.IsNullOrEmpty(l.CourtesyOf)) { <p class="small text-muted mt-3">İlan sahibi: @l.CourtesyOf</p> }
        </div>

        <aside class="col-lg-4">
            @if (l.Agent is { } a)
            {
                <div class="agent-box mb-4">
                    <img src="@(a.PhotoUrl ?? "/img/agent-placeholder.svg")" alt="@a.FullName" class="agent-thumb" />
                    <div>
                        <a href="/agents/@a.Id"><strong>@a.FullName</strong></a><br />
                        <span class="small">@a.Title</span><br />
                        @if (!string.IsNullOrEmpty(a.Phone)) { <a href="tel:@a.Phone" class="small">@a.Phone</a> }
                    </div>
                </div>
            }
            <div class="sidebar-box">
                @{ ViewData["FormHeading"] = "Bu ilan hakkında bilgi alın"; }
                <partial name="_ContactForm" model="Model.Contact" view-data="ViewData" />
            </div>
        </aside>
    </div>

    @if (Model.Similar.Count > 0)
    {
        <h3 class="section-title mt-5">Benzer İlanlar</h3>
        <div class="row g-4">@foreach (var s in Model.Similar) { <div class="col-md-4"><partial name="_ListingCard" model="s" /></div> }</div>
    }
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
