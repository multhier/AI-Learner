@inject SignInManager<ApplicationUser> SignInManager
@{
    var s = await SiteSettings.GetAllAsync();
    var title = ViewData["Title"] as string;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(string.IsNullOrEmpty(title) ? s["CompanyName"] : $"{title} | {s["CompanyName"]}")</title>
    <meta name="description" content="@(ViewData["Description"] ?? s["HomeListingsText"])" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Raleway:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Head", required: false)
</head>
<body>
<header class="site-header sticky-top">
    <nav class="navbar navbar-expand-lg navbar-light">
        <div class="container">
            <a class="navbar-brand" href="/">
                <span class="brand-mark">@s["CompanyName"].Split(' ').FirstOrDefault()</span>
                <span class="brand-sub">@string.Join(' ', s["CompanyName"].Split(' ').Skip(1))</span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Menüyü aç">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">İlanlar</a>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="/properties/sales">Satılık</a></li>
                            <li><a class="dropdown-item" href="/properties/rentals">Kiralık</a></li>
                            <li><a class="dropdown-item" href="/properties/commercial">Ticari</a></li>
                            <li><a class="dropdown-item" href="/properties/open-house">Açık Ev</a></li>
                            <li><a class="dropdown-item" href="/properties/short-term">Kısa Dönem</a></li>
                        </ul>
                    </li>
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Hakkımızda</a>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="/page/about">Şirketimiz</a></li>
                            <li><a class="dropdown-item" href="/agents">Danışmanlarımız</a></li>
                            <li><a class="dropdown-item" href="/news">Son Haberler</a></li>
                            <li><a class="dropdown-item" href="/careers">Kariyer</a></li>
                            <li><a class="dropdown-item" href="/owners">Mülkünü Listele</a></li>
                            <li><a class="dropdown-item" href="/page/disclaimer">Yasal Uyarı</a></li>
                            <li><a class="dropdown-item" href="/testimonials">Müşteri Yorumları</a></li>
                        </ul>
                    </li>
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Taşınma</a>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="/page/relocation">Taşınma Hakkında</a></li>
                            <li><a class="dropdown-item" href="/resources/renters">Kiracı Rehberi</a></li>
                            <li><a class="dropdown-item" href="/resources/buyers">Alıcı Rehberi</a></li>
                            <li><a class="dropdown-item" href="/resources/sellers">Satıcı Rehberi</a></li>
                            <li><a class="dropdown-item" href="/page/neighborhoods">Semt Rehberi</a></li>
                            <li><a class="dropdown-item" href="/page/links">Faydalı Bağlantılar</a></li>
                        </ul>
                    </li>
                    <li class="nav-item"><a class="nav-link" href="/contact">İletişim</a></li>
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Kaynaklar</a>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="/page/cbb">Sertifikalı Alıcı Brokeri</a></li>
                            <li><a class="dropdown-item" href="/blog">Faydalı İpuçları</a></li>
                        </ul>
                    </li>
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Florida</a>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="/page/florida">Florida Hakkında</a></li>
                            <li><a class="dropdown-item" href="/page/north-port">North Port / Port Charlotte</a></li>
                        </ul>
                    </li>
                    @if (SignInManager.IsSignedIn(User))
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Hesabım</a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" href="/account/favorites">Favorilerim</a></li>
                                @if (User.IsInRole("Admin"))
                                {
                                    <li><a class="dropdown-item" href="/admin">Yönetim Paneli</a></li>
                                }
                                <li>
                                    <form method="post" action="/account/logout">
                                        @Html.AntiForgeryToken()
                                        <button class="dropdown-item" type="submit">Çıkış Yap</button>
                                    </form>
                                </li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item"><a class="nav-link nav-login" href="/account/login">Giriş Yap</a></li>
                    }
                </ul>
            </div>
        </div>
    </nav>
</header>

<main>
    @if (TempData["Success"] is string ok)
    {
        <div class="container mt-3"><div class="alert alert-success alert-dismissible fade show" role="alert">@ok<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button></div></div>
    }
    @if (TempData["Error"] is string err)
    {
        <div class="container mt-3"><div class="alert alert-danger alert-dismissible fade show" role="alert">@err<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button></div></div>
    }
    @RenderBody()
</main>

<footer class="site-footer">
    <div class="container">
        <div class="row gy-4">
            <div class="col-md-5">
                <h5>@s["CompanyName"]</h5>
                <p class="mb-1">@s["Address"]</p>
                <p class="mb-1">@s["City"]</p>
                <p class="mb-1"><a href="tel:@s["Phone"]">@s["Phone"]</a> • <a href="mailto:@s["Email"]">@s["Email"]</a></p>
            </div>
            <div class="col-md-4">
                <h5>Hızlı Erişim</h5>
                <ul class="list-unstyled footer-links">
                    <li><a href="/properties/sales">Satılık İlanlar</a></li>
                    <li><a href="/properties/rentals">Kiralık İlanlar</a></li>
                    <li><a href="/agents">Danışmanlarımız</a></li>
                    <li><a href="/owners">Mülkünü Listele</a></li>
                </ul>
            </div>
            <div class="col-md-3">
                <h5>Bizi Takip Edin</h5>
                <div class="social">
                    @if (!string.IsNullOrEmpty(s["Facebook"])) { <a href="@s["Facebook"]" target="_blank" rel="noopener">Facebook</a> }
                    @if (!string.IsNullOrEmpty(s["Twitter"])) { <a href="@s["Twitter"]" target="_blank" rel="noopener">X / Twitter</a> }
                    @if (!string.IsNullOrEmpty(s["LinkedIn"])) { <a href="@s["LinkedIn"]" target="_blank" rel="noopener">LinkedIn</a> }
                </div>
                <p class="small mt-3 mb-0">Eşit Konut Fırsatı (Equal Housing Opportunity)</p>
            </div>
        </div>
        <hr />
        <p class="small mb-0">Copyright © @DateTime.Now.Year @s["CompanyName"]. Tüm hakları saklıdır.</p>
    </div>
</footer>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
