@model (int Page, int TotalPages, Func<int, string> Url)
@if (Model.TotalPages > 1)
{
    <nav aria-label="Sayfalar" class="mt-4">
        <ul class="pagination justify-content-center flex-wrap">
            <li class="page-item @(Model.Page <= 1 ? "disabled" : "")"><a class="page-link" href="@Model.Url(Model.Page - 1)">«</a></li>
            @for (var i = Math.Max(1, Model.Page - 3); i <= Math.Min(Model.TotalPages, Model.Page + 3); i++)
            {
                <li class="page-item @(i == Model.Page ? "active" : "")"><a class="page-link" href="@Model.Url(i)">@i</a></li>
            }
            <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")"><a class="page-link" href="@Model.Url(Model.Page + 1)">»</a></li>
        </ul>
    </nav>
}
