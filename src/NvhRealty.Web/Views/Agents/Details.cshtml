@model AgentDetailsViewModel
@{
    var a = Model.Agent;
    ViewData["Title"] = a.FullName;
    var s = await SiteSettings.GetAllAsync();
}
<section class="page-header"><div class="container"><h1>@a.FullName</h1><p class="mb-0">@a.Title</p></div></section>
<div class="container py-4">
    <div class="row g-4">
        <div class="col-md-3">
            <img src="@(a.PhotoUrl ?? "/img/agent-placeholder.svg")" alt="@a.FullName" class="img-fluid rounded mb-3" />
            <p class="mb-1"><strong>@a.FullName</strong><br />@s["CompanyName"]</p>
            @if (!string.IsNullOrEmpty(a.Phone)) { <p class="mb-1"><a href="tel:@a.Phone">@a.Phone</a></p> }
            @if (!string.IsNullOrEmpty(a.Email)) { <p class="mb-1"><a href="mailto:@a.Email">@a.Email</a></p> }
            @if (!string.IsNullOrEmpty(a.Languages)) { <p class="mb-2 small">Diller: @a.Languages</p> }
            <a href="/agents/@a.Id/vcard" class="btn btn-sm btn-outline-primary">V-Card'ı ekle</a>
        </div>
        <div class="col-md-9">
            <ul class="nav nav-tabs" role="tablist">
                <li class="nav-item" role="presentation"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab-bio" type="button" role="tab">Hakkında</button></li>
                <li class="nav-item" role="presentation"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-listings" type="button" role="tab">İlanlar (@Model.Listings.Count)</button></li>
                <li class="nav-item" role="presentation"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-test" type="button" role="tab">Yorumlar (@Model.Testimonials.Count)</button></li>
                <li class="nav-item" role="presentation"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-contact" type="button" role="tab">İletişim</button></li>
            </ul>
            <div class="tab-content pt-3">
                <div class="tab-pane fade show active rich-text" id="tab-bio" role="tabpanel">@Html.Raw(a.Bio)</div>
                <div class="tab-pane fade" id="tab-listings" role="tabpanel">
                    @if (Model.Listings.Count == 0) { <p>Bu danışmanın aktif ilanı yok.</p> }
                    <div class="row g-4">@foreach (var l in Model.Listings) { <div class="col-md-6 col-lg-4"><partial name="_ListingCard" model="l" /></div> }</div>
                </div>
                <div class="tab-pane fade" id="tab-test" role="tabpanel">
                    @if (Model.Testimonials.Count == 0) { <p>Henüz yorum yok.</p> }
                    @foreach (var t in Model.Testimonials) { <partial name="_Testimonial" model="t" /> }
                </div>
                <div class="tab-pane fade" id="tab-contact" role="tabpanel">
                    @{ ViewData["FormHeading"] = $"{a.FirstName} ile iletişime geçin"; }
                    <partial name="_ContactForm" model="Model.Contact" view-data="ViewData" />
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
