@model List<Listing>
@{
    ViewData["Title"] = "İlanlar";
    int total = ViewBag.Total, page = ViewBag.Page, size = ViewBag.PageSize;
    var pages = (int)Math.Ceiling(total / (double)size);
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">İlanlar <small class="text-muted">(@total)</small></h1>
    <a href="/admin/listings/create" class="btn btn-primary">+ Yeni ilan</a>
</div>
<form method="get" class="row g-2 mb-3">
    <div class="col-md-4"><input name="q" value="@ViewBag.Q" class="form-control" placeholder="Adres ara" /></div>
    <div class="col-md-3"><select name="type" class="form-select"><option value="">Tüm tipler</option>
        @foreach (ListingType t in Enum.GetValues<ListingType>()) { <option value="@t" selected="@(Equals(ViewBag.Type, t))">@t.DisplayName()</option> }</select></div>
    <div class="col-md-3"><select name="status" class="form-select"><option value="">Tüm durumlar</option>
        @foreach (ListingStatus s in Enum.GetValues<ListingStatus>()) { <option value="@s" selected="@(Equals(ViewBag.Status, s))">@s.DisplayName()</option> }</select></div>
    <div class="col-md-2"><button class="btn btn-secondary w-100">Filtrele</button></div>
</form>
<div class="table-responsive">
<table class="table table-hover bg-white align-middle">
    <thead><tr><th>#</th><th>Adres</th><th>Semt</th><th>Tip</th><th>Durum</th><th class="text-end">Fiyat</th><th>Danışman</th><th>Tarih</th><th></th></tr></thead>
    <tbody>
    @foreach (var l in Model)
    {
        <tr>
            <td>@l.Id</td>
            <td><a href="/properties/@l.Id" target="_blank">@l.Address@(string.IsNullOrEmpty(l.Unit) ? "" : $" #{l.Unit}")</a><div class="small text-muted">@l.PropertyType.DisplayName() · @l.BedsLabel() · @l.Source.DisplayName()</div></td>
            <td>@l.Neighborhood?.Name</td>
            <td>@l.ListingType.DisplayName()</td>
            <td>@l.Status.DisplayName()</td>
            <td class="text-end">@l.PriceLabel()</td>
            <td>@l.Agent?.FullName</td>
            <td>@l.ListedOn.ToString("dd.MM.yyyy")</td>
            <td class="text-nowrap"><a class="btn btn-sm btn-outline-primary" href="/admin/listings/edit/@l.Id">Düzenle</a> <partial name="_DeleteButton" model="@($"/admin/listings/delete/{l.Id}")" /></td>
        </tr>
    }
    </tbody>
</table>
</div>
@if (pages > 1)
{
    <nav><ul class="pagination flex-wrap">
        @for (var i = 1; i <= pages; i++) { <li class="page-item @(i == page ? "active" : "")"><a class="page-link" href="?page=@i&q=@ViewBag.Q&type=@ViewBag.Type&status=@ViewBag.Status">@i</a></li> }
    </ul></nav>
}
