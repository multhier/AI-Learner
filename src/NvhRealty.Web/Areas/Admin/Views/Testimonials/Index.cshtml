@model List<Testimonial>
@{ ViewData["Title"] = "Müşteri Yorumları"; }
<div class="d-flex justify-content-between align-items-center mb-3"><h1 class="h3 mb-0">Müşteri Yorumları</h1><a href="/admin/testimonials/create" class="btn btn-primary">+ Yeni yorum</a></div>
<table class="table table-hover bg-white align-middle">
    <thead><tr><th>Tarih</th><th>Müşteri</th><th>Başlık</th><th>Danışman</th><th>Durum</th><th></th></tr></thead>
    <tbody>
    @foreach (var t in Model)
    {
        <tr>
            <td>@t.Date.ToString("dd.MM.yyyy")</td><td>@t.ClientName</td><td>@t.Headline</td><td>@t.Agent?.FullName</td>
            <td>@(t.IsApproved ? "Onaylı" : "Bekliyor")</td>
            <td class="text-nowrap"><a class="btn btn-sm btn-outline-primary" href="/admin/testimonials/edit/@t.Id">Düzenle</a> <partial name="_DeleteButton" model="@($"/admin/testimonials/delete/{t.Id}")" /></td>
        </tr>
    }
    </tbody>
</table>
