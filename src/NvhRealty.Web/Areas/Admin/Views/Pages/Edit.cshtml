@model ContentPage
@{ ViewData["Title"] = Model.Id == 0 ? "Yeni sayfa" : Model.Title; }
<h1 class="h3 mb-3">@ViewData["Title"]</h1>
<form method="post" action="/admin/pages/save" class="admin-form">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="row g-3">
        <div class="col-md-3"><label asp-for="Slug" class="form-label"></label><input asp-for="Slug" class="form-control" /></div>
        <div class="col-md-5"><label asp-for="Title" class="form-label"></label><input asp-for="Title" class="form-control" /></div>
        <div class="col-md-4"><label asp-for="VideoUrl" class="form-label"></label><input asp-for="VideoUrl" class="form-control" /></div>
        <div class="col-12"><label asp-for="Body" class="form-label"></label><textarea asp-for="Body" rows="16" class="form-control font-monospace"></textarea></div>
    </div>
    <div class="mt-4 d-flex gap-2"><button type="submit" class="btn btn-primary">Kaydet</button><a href="/admin/pages" class="btn btn-link">İptal</a></div>
</form>
