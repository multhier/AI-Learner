@model List<ContentPage>
@{ ViewData["Title"] = "Sayfalar"; }
<div class="d-flex justify-content-between align-items-center mb-3"><h1 class="h3 mb-0">İçerik Sayfaları</h1><a href="/admin/pages/create" class="btn btn-primary">+ Yeni sayfa</a></div>
<table class="table table-hover bg-white align-middle">
    <thead><tr><th>Kısa ad</th><th>Başlık</th><th>Adres</th><th>Güncelleme</th><th></th></tr></thead>
    <tbody>
    @foreach (var p in Model)
    {
        <tr>
            <td><code>@p.Slug</code></td><td>@p.Title</td><td><a href="/page/@p.Slug" target="_blank">/page/@p.Slug</a></td><td>@p.UpdatedAt.ToLocalTime().ToString("dd.MM.yyyy")</td>
            <td class="text-nowrap"><a class="btn btn-sm btn-outline-primary" href="/admin/pages/edit/@p.Id">Düzenle</a> <partial name="_DeleteButton" model="@($"/admin/pages/delete/{p.Id}")" /></td>
        </tr>
    }
    </tbody>
</table>
<p class="small text-muted">"buyers", "sellers", "renters" sayfaları /resources/... adresinde; "owners" ve "careers" sayfalarının metni ilgili formların üstünde gösterilir.</p>
