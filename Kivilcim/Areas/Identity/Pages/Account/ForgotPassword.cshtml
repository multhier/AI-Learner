@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Şifremi unuttum";
}
<div class="row justify-content-center">
    <div class="col-sm-10 col-md-7 col-lg-5">
        <div class="card auth-card">
            <div class="card-body p-4">
                <div class="text-center mb-4">
                    <div class="auth-logo"><span class="brand-spark">✦</span> Kıvılcım</div>
                    <h1 class="h4 mt-2 mb-1">Şifreni mi unuttun?</h1>
                    <p class="text-muted small mb-0">E-posta adresini yaz, sana şifre sıfırlama bağlantısı gönderelim.</p>
                </div>
                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>
                    <div class="form-floating mb-3">
                        <input asp-for="Input.Email" class="form-control" autocomplete="username" placeholder="ornek@eposta.com" />
                        <label asp-for="Input.Email"></label>
                        <span asp-validation-for="Input.Email" class="text-danger small"></span>
                    </div>
                    <button id="forgot-submit" type="submit" class="w-100 btn btn-lg btn-spark">Bağlantı gönder</button>
                </form>
                <p class="text-center mt-4 mb-0"><a asp-page="./Login" class="auth-link">Giriş sayfasına dön</a></p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
