@page
@model LogoutModel
@{
    ViewData["Title"] = "Çıkış yap";
}
<div class="row justify-content-center">
    <div class="col-sm-10 col-md-7 col-lg-5">
        <div class="card auth-card"><div class="card-body p-4 text-center">
            <h1 class="h4">Çıkış yapmak istiyor musun?</h1>
            <form method="post" class="mt-3">
                <button type="submit" class="btn btn-spark">Çıkış yap</button>
                <a href="/" class="btn btn-outline-secondary">Vazgeç</a>
            </form>
        </div></div>
    </div>
</div>
