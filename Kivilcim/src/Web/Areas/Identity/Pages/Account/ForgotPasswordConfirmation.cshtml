@page
@model ForgotPasswordConfirmationModel
@{
    ViewData["Title"] = "E-postanı kontrol et";
}
<div class="row justify-content-center">
    <div class="col-sm-10 col-md-7 col-lg-5">
        <div class="card auth-card"><div class="card-body p-4 text-center">
            <div class="display-6 mb-2">📬</div>
            <h1 class="h4">E-postanı kontrol et</h1>
            <p class="text-muted">Bu adresle bir hesap varsa şifre sıfırlama bağlantısı gönderildi. Gelen kutunda yoksa spam klasörüne de bak.</p>
            <a asp-page="./Login" class="btn btn-spark">Giriş sayfasına dön</a>
        </div></div>
    </div>
</div>
