@page
@model IndexModel
@{
    ViewData["Title"] = "Hesap ayarları";
}
<h2 class="h5 mb-3">Genel bakış</h2>
<dl class="row mb-0">
    <dt class="col-sm-4">E-posta</dt>
    <dd class="col-sm-8">@Model.Email</dd>
    <dt class="col-sm-4">Blog adresi</dt>
    <dd class="col-sm-8"><a href="/blog/@Model.BlogName">/blog/@Model.BlogName</a></dd>
    <dt class="col-sm-4">Katılım</dt>
    <dd class="col-sm-8">@Model.CreatedAt.ToLocalTime().ToString("d MMMM yyyy", new System.Globalization.CultureInfo("tr-TR"))</dd>
</dl>
