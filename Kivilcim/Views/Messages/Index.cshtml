@model List<ConversationViewModel>
@{
    ViewData["Title"] = "Mesajlar";
}
<div class="row justify-content-center">
    <div class="col-lg-7 col-xl-6">
        <h1 class="h3 section-title mb-4">Mesajlar</h1>
        <div class="card">
            @if (Model.Count == 0)
            {
                <div class="card-body text-center text-muted py-5">
                    Henüz mesajın yok. Bir blog sayfasındaki <strong>✉ Mesaj gönder</strong> düğmesiyle sohbet başlatabilirsin.
                </div>
            }
            <ul class="list-group list-group-flush">
                @foreach (var c in Model)
                {
                    <li class="list-group-item @(c.UnreadCount > 0 ? "unread" : "")">
                        <a href="/messages/@c.BlogName" class="d-flex align-items-center gap-3 text-reset text-decoration-none">
                            <partial name="_Avatar" model="@((c.AvatarPath, c.DisplayName, 44))" />
                            <div class="flex-grow-1 min-w-0">
                                <div class="d-flex justify-content-between">
                                    <strong>@c.DisplayName</strong>
                                    <span class="small text-muted">@TextFormat.TimeAgo(c.LastAt)</span>
                                </div>
                                <div class="small text-muted text-truncate">@(c.LastFromMe ? "Sen: " : "")@c.LastMessage</div>
                            </div>
                            @if (c.UnreadCount > 0)
                            {
                                <span class="badge rounded-pill bg-danger">@c.UnreadCount</span>
                            }
                        </a>
                    </li>
                }
            </ul>
        </div>
    </div>
</div>
