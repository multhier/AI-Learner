@model PostDetailsViewModel
@{
    ViewData["Title"] = Model.Post.Title ?? $"{Model.Post.AuthorBlogName} gönderisi";
    var signedIn = User.Identity?.IsAuthenticated == true;
}

<div class="row justify-content-center">
    <div class="col-lg-7 col-xl-6">
        <partial name="_PostCard" model="Model.Post" />

        @if (signedIn)
        {
            <section class="card mb-4">
                <div class="card-body">
                    <h2 class="h6 mb-3">Yorumla yeniden paylaş</h2>
                    <form method="post" action="/Posts/Reblog/@Model.Post.Id">
                        @Html.AntiForgeryToken()
                        <textarea name="comment" class="form-control mb-2" rows="2" maxlength="2000" placeholder="Bir şey ekle (isteğe bağlı)"></textarea>
                        <input name="tags" class="form-control mb-2" placeholder="Etiketler (isteğe bağlı)" />
                        <button class="btn btn-outline-spark btn-sm" type="submit">⟳ Yeniden paylaş</button>
                    </form>
                </div>
            </section>
        }

        <section class="card mb-4" id="yanitlar">
            <div class="card-body">
                <h2 class="h6 mb-3">Yanıtlar (@Model.Replies.Count)</h2>
                @foreach (var r in Model.Replies)
                {
                    <div class="d-flex gap-2 mb-3">
                        <partial name="_Avatar" model="@((r.AvatarPath, r.DisplayName, 32))" />
                        <div>
                            <a href="/blog/@r.BlogName" class="fw-semibold text-reset">@r.BlogName</a>
                            <span class="small text-muted">· @TextFormat.TimeAgo(r.CreatedAt)</span>
                            <div>@TextFormat.Paragraphs(r.Body)</div>
                        </div>
                    </div>
                }
                @if (signedIn)
                {
                    <form method="post" action="/Posts/Reply/@Model.Post.Id" class="d-flex gap-2">
                        @Html.AntiForgeryToken()
                        <input name="body" class="form-control" maxlength="2000" placeholder="Yanıt yaz..." required />
                        <button class="btn btn-spark" type="submit">Gönder</button>
                    </form>
                }
                else
                {
                    <p class="small text-muted mb-0">
                        Yanıt yazmak için <a asp-area="Identity" asp-page="/Account/Login" asp-route-returnUrl="/post/@Model.Post.Id">giriş yap</a>.
                    </p>
                }
            </div>
        </section>

        <section class="card mb-4" id="notlar">
            <div class="card-body">
                <h2 class="h6 mb-3">Notlar (@Model.Post.NoteCount)</h2>
                @if (Model.RecentNotes.Count == 0)
                {
                    <p class="small text-muted mb-0">Henüz not yok.</p>
                }
                <ul class="list-unstyled mb-0">
                    @foreach (var n in Model.RecentNotes)
                    {
                        <li class="small mb-1">
                            @(n.Kind == "like" ? "♥" : "⟳")
                            <a href="/blog/@n.BlogName" class="fw-semibold text-reset">@n.BlogName</a>
                            @(n.Kind == "like" ? "beğendi" : "yeniden paylaştı")
                            <span class="text-muted">· @TextFormat.TimeAgo(n.CreatedAt)</span>
                        </li>
                    }
                </ul>
            </div>
        </section>
    </div>
</div>
