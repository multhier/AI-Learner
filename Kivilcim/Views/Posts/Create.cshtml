@model CreatePostViewModel
@{
    ViewData["Title"] = "Yeni gönderi";
    var types = new (PostType Type, string Label)[]
    {
        (PostType.Text, "Metin"), (PostType.Photo, "Fotoğraf"), (PostType.Quote, "Alıntı"), (PostType.Link, "Bağlantı")
    };
}

<div class="row justify-content-center">
    <div class="col-lg-7 col-xl-6">
        <div class="card">
            <div class="card-header">
                <ul class="nav nav-pills card-header-pills">
                    @foreach (var t in types)
                    {
                        <li class="nav-item">
                            <a class="nav-link @(Model.Type == t.Type ? "active" : "")" href="/new/@t.Type">@t.Label</a>
                        </li>
                    }
                </ul>
            </div>
            <div class="card-body">
                <form method="post" action="/new/@Model.Type" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Type" />
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    @if (Model.Type == PostType.Photo)
                    {
                        <div class="mb-3">
                            <label asp-for="Image" class="form-label"></label>
                            <input asp-for="Image" type="file" class="form-control" accept="image/jpeg,image/png,image/gif,image/webp" />
                            <div class="form-text">JPG, PNG, GIF veya WEBP · en fazla 5 MB</div>
                            <span asp-validation-for="Image" class="text-danger"></span>
                            <img id="imagePreview" class="post-image mt-3 d-none" alt="Önizleme" />
                        </div>
                    }

                    @if (Model.Type == PostType.Link)
                    {
                        <div class="mb-3">
                            <label asp-for="LinkUrl" class="form-label"></label>
                            <input asp-for="LinkUrl" type="url" class="form-control" placeholder="https://..." />
                            <span asp-validation-for="LinkUrl" class="text-danger"></span>
                        </div>
                    }

                    <div class="mb-3">
                        <label asp-for="Title" class="form-label">@(Model.Type == PostType.Quote ? "Kaynak (kimin sözü?)" : "Başlık")</label>
                        <input asp-for="Title" class="form-control" />
                        <span asp-validation-for="Title" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Body" class="form-label">@(Model.Type == PostType.Quote ? "Alıntı" : Model.Type == PostType.Text ? "Metin" : "Açıklama")</label>
                        <textarea asp-for="Body" class="form-control" rows="@(Model.Type == PostType.Text ? 8 : 4)"></textarea>
                        <span asp-validation-for="Body" class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Tags" class="form-label"></label>
                        <input asp-for="Tags" class="form-control" placeholder="#kedi, #yaz tatili" />
                        <div class="form-text">Virgülle ayırın · en fazla 10 etiket</div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-spark px-4">Paylaş</button>
                        <a href="/" class="btn btn-outline-secondary">Vazgeç</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
