@model PostCardViewModel
@{
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
    var signedIn = User.Identity?.IsAuthenticated == true;
    var isMine = signedIn && Model.AuthorId == User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
}
<article class="post-card card mb-4" id="post-@Model.Id">
    <div class="card-header d-flex align-items-center gap-2">
        <a href="/blog/@Model.AuthorBlogName" class="d-flex align-items-center gap-2 text-reset text-decoration-none">
            <partial name="_Avatar" model="@((Model.AuthorAvatar, Model.AuthorDisplayName, 36))" />
            <span class="fw-semibold">@Model.AuthorBlogName</span>
        </a>
        @if (Model.Original != null)
        {
            <span class="text-muted small">⟳ yeniden paylaştı</span>
            <a href="/blog/@Model.Original.AuthorBlogName" class="small fw-semibold text-reset">@Model.Original.AuthorBlogName</a>
        }
        <a href="/post/@Model.Id" class="ms-auto small text-muted text-decoration-none" title="@Model.CreatedAt.ToLocalTime()">
            @TextFormat.TimeAgo(Model.CreatedAt)
        </a>
    </div>

    <div class="card-body">
        @if (Model.Original != null)
        {
            <div class="reblog-source mb-3">
                <partial name="_PostContent" model="@((Model.Original.Type, Model.Original.Title, Model.Original.Body, Model.Original.ImagePath, Model.Original.LinkUrl))" />
                <a href="/post/@Model.Original.Id" class="small text-muted">Asıl gönderiye git →</a>
            </div>
            @if (!string.IsNullOrEmpty(Model.Body))
            {
                <div class="reblog-comment">
                    <a href="/blog/@Model.AuthorBlogName" class="fw-semibold text-reset">@Model.AuthorBlogName:</a>
                    @TextFormat.Paragraphs(Model.Body)
                </div>
            }
        }
        else
        {
            <partial name="_PostContent" model="@((Model.Type, Model.Title, Model.Body, Model.ImagePath, Model.LinkUrl))" />
        }

        @if (Model.Tags.Count > 0)
        {
            <div class="post-tags mt-3">
                @foreach (var tag in Model.Tags)
                {
                    <a href="/tagged/@Uri.EscapeDataString(tag)" class="tag">#@tag</a>
                }
            </div>
        }
    </div>

    <div class="card-footer d-flex align-items-center gap-1">
        <a href="/post/@Model.Id#notlar" class="notes text-muted small me-auto">@Model.NoteCount not</a>

        <a href="/post/@Model.Id#yanitlar" class="btn btn-action" title="Yanıtla" aria-label="Yanıtla">
            💬 <span class="small">@Model.ReplyCount</span>
        </a>

        @if (signedIn)
        {
            <form method="post" action="/Posts/Reblog/@Model.Id" class="d-inline">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@returnUrl" />
                <button type="submit" class="btn btn-action" title="Yeniden paylaş" aria-label="Yeniden paylaş">⟳</button>
            </form>
            <form method="post" action="/Posts/Like/@Model.Id" class="d-inline like-form">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@returnUrl" />
                <button type="submit" class="btn btn-action like-btn @(Model.LikedByMe ? "liked" : "")"
                        aria-pressed="@(Model.LikedByMe ? "true" : "false")" title="Beğen" aria-label="Beğen">
                    <span class="heart">@(Model.LikedByMe ? "♥" : "♡")</span>
                    <span class="small like-count">@Model.LikeCount</span>
                </button>
            </form>
            @if (isMine)
            {
                <form method="post" action="/Posts/Delete/@Model.Id" class="d-inline"
                      onsubmit="return confirm('Bu gönderi silinsin mi?');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-action text-danger" title="Sil" aria-label="Sil">🗑</button>
                </form>
            }
        }
        else
        {
            <a class="btn btn-action" asp-area="Identity" asp-page="/Account/Login" asp-route-returnUrl="@returnUrl" title="Beğenmek için giriş yap">
                ♡ <span class="small">@Model.LikeCount</span>
            </a>
        }
    </div>
</article>
