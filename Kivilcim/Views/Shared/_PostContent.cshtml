@model PostContentModel
@switch (Model.Type)
{
    case PostType.Photo:
        @if (Model.Images.Count > 0)
        {
            var count = Model.Images.Count;
            <div class="photo-grid photo-grid-@(Math.Min(count, 4)) mb-3" data-count="@count">
                @for (var i = 0; i < count; i++)
                {
                    var src = Model.Images[i];
                    var external = !src.StartsWith("/");
                    <a href="@src" target="_blank" rel="noopener noreferrer" class="photo-cell">
                        <img src="@src" alt="@(Model.Title ?? "Gönderi görseli") @(i + 1)" class="@(count == 1 ? "post-image" : "")"
                             loading="lazy" @(external ? "referrerpolicy=no-referrer" : "") />
                    </a>
                }
            </div>
        }
        @if (!string.IsNullOrEmpty(Model.Title)) { <h2 class="post-title">@Model.Title</h2> }
        <div class="post-body">@TextFormat.Paragraphs(Model.Body)</div>
        break;

    case PostType.Video:
        @if (!string.IsNullOrEmpty(Model.VideoPath))
        {
            <video src="@Model.VideoPath" class="post-video mb-3" controls preload="metadata" playsinline></video>
        }
        @if (!string.IsNullOrEmpty(Model.Title)) { <h2 class="post-title">@Model.Title</h2> }
        <div class="post-body">@TextFormat.Paragraphs(Model.Body)</div>
        break;

    case PostType.Quote:
        <blockquote class="post-quote">“@TextFormat.Paragraphs(Model.Body)”</blockquote>
        @if (!string.IsNullOrEmpty(Model.Title)) { <div class="text-muted">— @Model.Title</div> }
        break;

    case PostType.Link:
        @if (TextFormat.IsSafeHttpUrl(Model.LinkUrl))
        {
            <a href="@Model.LinkUrl" class="post-link d-block mb-2" target="_blank" rel="noopener noreferrer nofollow">
                <span class="fw-semibold">@(Model.Title ?? Model.LinkUrl)</span>
                <span class="d-block small text-muted text-truncate">@(new Uri(Model.LinkUrl!).Host)</span>
            </a>
        }
        <div class="post-body">@TextFormat.Paragraphs(Model.Body)</div>
        break;

    default:
        @if (!string.IsNullOrEmpty(Model.Title)) { <h2 class="post-title">@Model.Title</h2> }
        <div class="post-body">@TextFormat.Paragraphs(Model.Body)</div>
        break;
}
